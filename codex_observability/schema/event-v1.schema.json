{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-observability:event:v1",
  "title": "Codex observability event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "occurred_at",
    "task_id",
    "run_id",
    "event_type",
    "actor",
    "emitter",
    "task_kind",
    "outcome",
    "model",
    "reasoning_effort",
    "duration_ms",
    "input_tokens",
    "cached_input_tokens",
    "output_tokens",
    "skills",
    "fix_round",
    "finding_count",
    "scope_status",
    "decision_reason"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "occurred_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "event_type": {
      "enum": [
        "task.started",
        "task.completed",
        "delegation.started",
        "delegation.completed",
        "review.completed",
        "fix_round.started",
        "decision.returned",
        "scope.checked"
      ]
    },
    "actor": {"enum": ["user", "sol", "luna", "reviewer", "system"]},
    "emitter": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,127}$"},
    "task_kind": {"enum": ["implementation", "review", "research", "documentation", "operations", "unknown"]},
    "outcome": {"enum": ["started", "succeeded", "failed", "returned", "rejected", "adopted", "partial", "unknown"]},
    "model": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,127}$"
    },
    "reasoning_effort": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+@-]{0,127}$"
    },
    "duration_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 604800000},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000},
    "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000},
    "skills": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"}
    },
    "fix_round": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
    "finding_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
    "scope_status": {"enum": ["passed", "violated", "not_checked"]},
    "decision_reason": {
      "enum": [null, "architecture", "compatibility", "authorization", "scope", "security", "requirements", "work_budget", "other"]
    }
  }
}
